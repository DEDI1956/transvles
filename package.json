{
  "name": "zivpn-manager",
  "version": "1.0.0",
  "description": "Advanced VPN Manager with SSH Tunneling and Web Interface",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build:static && npm run build:api-docs",
    "build:static": "cp -r public/* build/ 2>/dev/null || true",
    "build:api-docs": "node scripts/generate-docs.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "vpn",
    "ssh-tunnel",
    "proxy",
    "networking",
    "security",
    "tunneling",
    "port-forwarding"
  ],
  "author": "VPN Manager Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "uuid": "^9.0.1",
    "fs-extra": "^11.2.0",
    "node-ssh": "^13.1.0",
    "ssh2": "^1.15.0",
    "ws": "^8.16.0",
    "eventemitter3": "^5.0.1",
    "moment": "^2.29.4",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "express-winston": "^4.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "@eslint/js": "^9.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest-environment-node": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/username/zivpn-manager.git"
  },
  "bugs": {
    "url": "https://github.com/username/zivpn-manager/issues"
  },
  "homepage": "https://github.com/username/zivpn-manager#readme"
}