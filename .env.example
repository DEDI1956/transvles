# ZiVPN Manager Environment Configuration

# Application Settings
NODE_ENV=development
PORT=3000

# Security Settings
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-change-in-production
SESSION_SECRET=your-super-secret-session-key-here-change-in-production

# API Configuration
API_PREFIX=/api/v1

# CORS Settings (comma-separated list for production)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# SSH Tunnel Configuration (Default)
SSH_HOST=localhost
SSH_USER=admin123
SSH_PASSWORD=test
SSH_PRIVATE_KEY=your-private-key-path

# VPN Service Configuration
VPN_MAX_CONNECTIONS=100
VPN_DEFAULT_RECONNECT_DELAY=5000
VPN_ENABLE_METRICS=true

# Logging Configuration
LOG_LEVEL=info
LOG_ENABLE_FILE_LOGGING=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (if using external DB)
# DATABASE_URL=postgresql://user:password@localhost:5432/zivpn

# Redis Configuration (for session storage)
# REDIS_URL=redis://localhost:6379

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=ZiVPN Manager <noreply@yourdomain.com>

# Monitoring and Analytics
# SENTRY_DSN=your-sentry-dsn-here
# GOOGLE_ANALYTICS_ID=your-ga-id

# Cloud Provider Settings
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1

# SSL/TLS Configuration
# SSL_CERT_PATH=/path/to/certificate.crt
# SSL_KEY_PATH=/path/to/private.key

# Backup Configuration
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_PROXY=true
ENABLE_TUNNELING=true
ENABLE_MONITORING=true

# Development Tools
DEBUG=zivpn:*
VERBOSE_LOGGING=false
